{
  "name": "open-a-pull-request",
  "version": "1.0.0",
  "description": "Use when a branch is ready for other people to read. Keep it small, linked, and green — one intent per PR, named branch, filled body, checks passing before review.",
  "schema": {
    "input": {
      "type": "object",
      "properties": {
        "issue_number": { "type": "integer", "description": "Linked issue. Required — unlinked PRs get closed." },
        "branch": { "type": "string", "description": "Branch name. Defaults to <type>/issue-<N>." },
        "branch_type": { "type": "string", "default": "feat", "description": "Branch prefix: feat/fix/refactor/docs/chore." },
        "title": { "type": "string", "description": "PR title (single intent, Conventional style)." },
        "summary": { "type": "string", "description": "What the PR delivers and why." },
        "test_plan": { "type": "string", "description": "Checks run + results." },
        "base": { "type": "string", "default": "main" },
        "draft": { "type": "boolean", "default": false },
        "dry_run": {
          "type": "boolean",
          "default": true,
          "description": "true = plan + commands only. false = push + gh pr create."
        }
      },
      "required": ["issue_number"]
    },
    "output": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "skill": { "type": "string" },
        "gate": {
          "type": "string",
          "enum": ["link-first", "plan", "open"]
        },
        "branch": { "type": "string" },
        "pr_body": { "type": "string" }
      }
    }
  },
  "handler": "open-a-pull-request-handler",
  "mode": "auto",
  "sourceProvider": "local",
  "tags": ["github", "pull-request", "gh-cli", "workflow"]
}
