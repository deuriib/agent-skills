# Normalize line endings: LF in the repo, native on checkout (platform-correct).
* text=auto

# Explicitly declare text files that Git may otherwise misdetect.
*.md        text eol=lf
*.json      text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.jsx       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.npmrc     text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.svg       text eol=lf

# Windows-only scripts must stay CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files: never touch content, never diff textually.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tgz  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.mp4  binary
*.wasm binary
