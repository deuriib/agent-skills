{
  "name": "project-bootstrap",
  "version": "1.0.0",
  "description": "Use when a repo is missing standard hygiene files or a new project needs its baseline scaffold. Creates .gitattributes, .gitignore, .npmrc, .editorconfig, pre-commit, bump-version, LICENSE, README, CHANGELOG, CODE_OF_CONDUCT, PRODUCT without clobbering.",
  "schema": {
    "input": {
      "type": "object",
      "required": ["project"],
      "properties": {
        "project": { "type": "string", "description": "Directory/repo name to bootstrap (required)." },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "year": { "type": "number" },
        "contact": { "type": "string" },
        "license": { "type": "string", "default": "MIT" },
        "status": { "type": "string" },
        "install_cmd": { "type": "string" },
        "usage_cmd": { "type": "string" },
        "dev_cmd": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Limit the run to these managed files. Empty/omitted = all 12."
        },
        "force": { "type": "boolean", "default": false },
        "dry_run": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["success", "skill", "gate", "dry_run", "files"],
      "properties": {
        "success": { "type": "boolean" },
        "skill": { "type": "string" },
        "gate": {
          "type": "string",
          "enum": ["dry-run", "applied", "need-project", "unknown-file"]
        },
        "dry_run": { "type": "boolean" },
        "project": { "type": "string" },
        "summary": { "type": "string" },
        "message": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "status"],
            "properties": {
              "path": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["created", "merged", "skipped", "would_create", "would_skip"]
              },
              "note": { "type": "string" }
            }
          }
        },
        "next_steps": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "handler": "project-bootstrap-handler",
  "mode": "auto",
  "sourceProvider": "local",
  "tags": ["bootstrap", "scaffolding", "repo-hygiene", "versioning", "onboarding"]
}
