{
  "name": "htmx",
  "version": "1.0.0",
  "description": "Trigger: htmx, HTMX, hypermedia, hx-get, hx-post, hx-trigger, hx-target, hx-swap, AJAX, HTML-over-the-wire. Build modern web interfaces using HTML attributes instead of JavaScript frameworks. Covers htmx attributes, events, extensions, server-side integration patterns, and UI examples.",
  "schema": {
    "input": {
      "type": "object",
      "properties": {
        "task": { "type": "string", "description": "One sentence: the dynamic UI behavior needed. Required." },
        "pattern": {
          "type": "string",
          "enum": ["ajax", "form", "infinite-scroll", "live-search", "click-to-edit", "realtime", "history", "boost", "custom"],
          "default": "custom",
          "description": "UI pattern preset. 'custom' composes hx-* from method/trigger/target/swap."
        },
        "method": {
          "type": "string",
          "enum": ["get", "post", "put", "patch", "delete"],
          "default": "get",
          "description": "HTTP verb for hx-* (custom pattern)."
        },
        "trigger": { "type": "string", "description": "hx-trigger value, e.g. 'revealed', 'every 2s', 'keyup changed delay:300ms'." },
        "target": { "type": "string", "description": "hx-target CSS selector, e.g. '#results'." },
        "swap": {
          "type": "string",
          "enum": ["innerHTML", "outerHTML", "beforebegin", "afterbegin", "beforeend", "afterend", "delete", "none"],
          "default": "innerHTML"
        },
        "snippet": { "type": "string", "description": "Existing HTML to review against htmx hard rules." }
      },
      "required": ["task"]
    },
    "output": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "skill": { "type": "string" },
        "pattern": { "type": "string" },
        "element_scaffold": { "type": "string" },
        "server_contract": { "type": "string" }
      }
    }
  },
  "handler": "htmx-handler",
  "mode": "auto",
  "sourceProvider": "local",
  "tags": ["htmx", "hypermedia", "frontend", "html-over-the-wire"]
}
